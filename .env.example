# Copy this file to .env in the same directory as docker-compose.yml.
MYSQL_DATABASE=event_manager
MYSQL_USER=event_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# For local demo only. Replace with a long random secret for any shared deployment.
JWT_SECRET_KEY=local_demo_change_this_to_a_long_random_secret_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Set SEED_DEMO=true and provide a password of 8-72 characters to create demo users.
SEED_DEMO=true
DEMO_PASSWORD=DemoPass123!
DEMO_ADMIN_PASSWORD=
DEMO_ORGANIZER_PASSWORD=
DEMO_STAFF_PASSWORD=
DEMO_ATTENDEE_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
