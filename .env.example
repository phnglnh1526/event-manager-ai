# ==============================================================================
# EVENT MANAGER AI V2 - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Chọn 1 trong 2 chế độ phát triển bên dưới:
#
# ------------------------------------------------------------------------------
# CHẾ ĐỘ A: SHARED BACKEND DEVELOPMENT (Khuyến nghị cho thành viên frontend/nhóm)
# ------------------------------------------------------------------------------
# Sử dụng chung Backend API & Centralized Database tập trung.
# Không cần chạy MySQL local, không lo xung đột cổng 3306 hoặc tên container.
#
# Chạy frontend kết nối Backend chung:
#   npm --prefix frontend run dev
# hoặc chạy Docker frontend:
#   docker compose up frontend
#
VITE_API_BASE_URL=http://localhost:8000
# (Thay localhost:8000 bằng IP/domain máy chủ Backend chung khi kết nối từ xa)

# ------------------------------------------------------------------------------
# CHẾ ĐỘ B: FULL LOCAL DEVELOPMENT (Dành cho kiểm thử độc lập/local)
# ------------------------------------------------------------------------------
# Chạy toàn bộ MySQL, Backend, Frontend trên máy cá nhân với database riêng.
#
# 1. Cấu hình Database Local:
MYSQL_DATABASE=event_manager
MYSQL_USER=event_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me

# Nếu cổng 3306 trên máy bị trùng (do cài sẵn MySQL) hoặc trùng tên container:
# Đổi các biến dưới đây để tránh xung đột:
MYSQL_LOCAL_PORT=3306
COMPOSE_DB_NAME=event-manager-db
COMPOSE_BACKEND_NAME=event-manager-backend
COMPOSE_FRONTEND_NAME=event-manager-frontend
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 2. Cấu hình Backend & Auth:
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=change_this_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# 3. Cấu hình AI & Mock Mode:
# "mock" (khuyến nghị cho demo local/test không tốn token) hoặc "openai"
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# 4. Tùy chọn Seed & Cloudinary:
DEMO_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
